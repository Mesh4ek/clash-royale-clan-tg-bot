# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_ID=-1001234567890
# TELEGRAM_PROXY=http://127.0.0.1:8080  # Optional: if Telegram is blocked (VPN/proxy)
# POLL_INTERVAL=0  # Seconds between getUpdates; use 0 for responsive callbacks. High values delay updates.

# Bot language: a file name from locales/ without .json (en, uk, ...). Default: en. See locales/README.md
# BOT_LANGUAGE=en

# Clash Royale API (https://developer.clashroyale.com/)
CLASH_API_TOKEN=your_clash_royale_api_token
# REQUEST_TIMEOUT_SECONDS=15   # HTTP timeout for Clash API calls
# LOG_LEVEL=INFO               # DEBUG / INFO / WARNING
CLAN_TAG=#YOURCLANTAG
# CLASH_LOCATION_ID=57000246   # Optional: region for /rank. Default: the region set on the clan's Clash Royale profile
# War day reset time (UTC): hour and minute, default 9:30
# WAR_DAY_END_UTC=9
# WAR_DAY_END_MINUTE=30

# Auto reminder to group (UTC): default 9:00 = 30 min before war end
# WAR_REMINDER_UTC=9
# WAR_REMINDER_MINUTE=0

# /admin (list of admin commands), /logs, /data, /time, /unregister: comma-separated Telegram user IDs (admin-only). First ID = primary (weekly /data backup DM Thu).
# LOGS_ALLOWED_TG_IDS=123456789,987654321
#
# Weekly /data-style TSV to primary admin every Thursday at same UTC as /time boundary (war day end clock).
# WEEKLY_DATA_BACKUP=0   # set 0 to disable
#
# Secret /time (private chat, same admins): change war UTC times without redeploy.
# Subcommands (English only): /time boundary H M | /time reminder H M | /time auto | /time auto H M | /time notify H
# /time notify H: the "Notify everyone" button works only in the last H hours before the war day ends (default 12).
# Persists to database/war_schedule.json (or next to DATABASE_PATH). First run uses env above.